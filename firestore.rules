rules_version = '2';

// ============================================================
// Firestore セキュリティルール — 消耗品在庫管理アプリ (zaiko-shohin)
// 方針: 匿名認証(サインイン済み)のみ読み書き可 + 主要フィールドを検証
// ※ 本番環境モードの初期ルール(全拒否)から必ずこのルールへ差し替えてください
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function strMax(v, max) {
      return v is string && v.size() <= max;
    }

    // 品目マスタの妥当性チェック（更新時は結合後のドキュメント全体を検証）
    function validItem(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && strMax(d.get('model', ''), 100)
        && d.category is string && d.category.size() > 0 && d.category.size() <= 100
        && d.stock is number && d.stock >= 0
        && d.min is number && d.min >= 0
        && strMax(d.unit, 20)
        && d.price is number && d.price >= 0
        && strMax(d.get('location', ''), 100)
        && strMax(d.get('shelf', ''), 50)
        && strMax(d.get('supplier', ''), 100)
        && strMax(d.get('lead', ''), 50)
        && d.get('orderStatus', '未発注') in ['未発注', '様子見', '発注済']
        && strMax(d.get('photo', ''), 2000)
        && strMax(d.get('photoBy', ''), 60);
    }

    // 入出庫履歴の妥当性チェック
    function validLog(d) {
      return d.itemId is string && d.itemId.size() > 0 && d.itemId.size() <= 100
        && d.at is timestamp
        && d.kind in ['入庫', '出庫', '棚卸調整']
        && d.qty is number
        && d.after is number && d.after >= 0
        && strMax(d.get('person', ''), 60)
        && strMax(d.get('site', ''), 100)
        && strMax(d.get('memo', ''), 500);
    }

    // 名前だけのマスタ（現場・担当者）
    function validNamed(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 100;
    }

    // 品目マスタ
    match /items/{itemId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validItem(request.resource.data);
      allow delete: if signedIn();
    }

    // 入出庫履歴（記録は作成のみ。改ざん防止のため更新は不可、削除は品目削除時のみ想定）
    match /logs/{logId} {
      allow read: if signedIn();
      allow create: if signedIn() && validLog(request.resource.data);
      allow update: if false;
      allow delete: if signedIn();
    }

    // 現場マスタ（出庫時の「使った現場」）
    match /sites/{siteId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validNamed(request.resource.data);
      allow delete: if signedIn();
    }

    // 担当者マスタ（入出庫記録の担当者プルダウン）
    match /persons/{personId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validNamed(request.resource.data);
      allow delete: if signedIn();
    }

    // 区分マスタ（品目の区分の選択肢）
    match /categories/{categoryId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validNamed(request.resource.data);
      allow delete: if signedIn();
    }

    // 保管場所マスタ（品目の保管場所の選択肢）
    match /locations/{locationId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validNamed(request.resource.data);
      allow delete: if signedIn();
    }

    // ========== 鋼材セクション ==========
    // 消耗品側（items / logs / …）とは別コレクション。相互に影響しない。

    function numOrNull(v) {
      return v == null || v is number;
    }

    // 空欄のままCSV取込された項目は null で入る（規格・スケジュール・仕入先など）。
    // strMax は string しか通さないため、任意項目にはこちらを使う。
    function strMaxOrNull(v, max) {
      return v == null || (v is string && v.size() <= max);
    }

    // 鋼材の品目カタログ（数千件。JIS規格の品目を幅広く収録した裏の辞書）
    function validSteelCatalog(d) {
      return d.category is string && d.category.size() > 0 && d.category.size() <= 50
        && d.material is string && d.material.size() > 0 && d.material.size() <= 100
        && strMaxOrNull(d.get('size', null), 100)
        && strMaxOrNull(d.get('sch', null), 50)
        && strMaxOrNull(d.get('name', null), 200)
        && strMaxOrNull(d.get('jis', null), 100)
        && strMaxOrNull(d.get('unit', null), 20)
        && strMaxOrNull(d.get('supplier', null), 100)
        && numOrNull(d.get('unitWeight', null))
        && numOrNull(d.get('price', null))
        && numOrNull(d.get('safety', null));
    }

    // 鋼材の在庫（実際に扱っている品目だけ。拠点ごとに数量を持つ）
    function validSteelStock(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.category is string && d.category.size() > 0 && d.category.size() <= 50
        && d.inInventory is bool
        && d.get('hidden', false) is bool
        && d.matsumae is number && d.matsumae >= 0
        && d.iyo is number && d.iyo >= 0
        && d.toho is number && d.toho >= 0
        && d.get('safety', 0) is number && d.get('safety', 0) >= 0
        && strMaxOrNull(d.get('location', null), 100)
        && strMaxOrNull(d.get('unit', null), 20);
    }

    // 鋼材の入出庫履歴（誰が・いつ・何本・どの拠点）
    function validSteelLog(d) {
      return d.itemId is string && d.itemId.size() > 0 && d.itemId.size() <= 200
        && d.at is timestamp
        && d.kind in ['入庫', '出庫', '在庫登録', 'CSV取込', '棚卸調整']
        && d.qty is number
        && d.after is number
        && strMax(d.get('site', ''), 40)
        && strMax(d.get('person', ''), 60)
        && strMax(d.get('memo', ''), 500);
    }

    match /steelCatalog/{itemId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validSteelCatalog(request.resource.data);
      allow delete: if signedIn();
    }

    match /steelStock/{itemId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && validSteelStock(request.resource.data);
      allow delete: if signedIn();
    }

    // 履歴は改ざん防止のため更新不可（作成のみ）
    match /steelLogs/{logId} {
      allow read: if signedIn();
      allow create: if signedIn() && validSteelLog(request.resource.data);
      allow update: if false;
      allow delete: if signedIn();
    }

    // 上記以外は全面的に拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
